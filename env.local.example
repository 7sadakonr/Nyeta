# ==========================================
# Gemini AI Vision (Server-side ONLY)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# ==========================================
# Pusher Realtime Signaling
# ==========================================
PUSHER_APP_ID=your_pusher_app_id
NEXT_PUBLIC_PUSHER_KEY=your_pusher_public_key
PUSHER_SECRET=your_pusher_secret
NEXT_PUBLIC_PUSHER_CLUSTER=ap1

# ==========================================
# Session & Call Token Security (HMAC-SHA256)
# ==========================================
SESSION_SECRET=generate_a_random_32_char_string_here

# ==========================================
# Upstash Redis (Rate Limiting & Serverless State)
# Obtain via Vercel Marketplace -> Upstash Redis
# ==========================================
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ==========================================
# WebRTC TURN Relay (Production Fallback)
# e.g., Metered Video, Twilio Network Traversal, Xirsys
# ==========================================
TURN_URL=turn:global.relay.metered.ca:443?transport=tcp
TURN_USERNAME=your_metered_username
TURN_CREDENTIAL=your_metered_credential
